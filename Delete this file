<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laboratorio de Microeconomía: Movimientos vs Desplazamientos</title>
    <style>
        :root {
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-color: #1e293b;
            --primary: #2563eb;
            --demand-color: #1d4ed8; /* Tono azulado institucional ideal para la curva */
            --point-color: #10b981;
            --border: #e2e8f0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.4;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            margin-bottom: 20px;
        }

        h1 { margin: 0 0 5px 0; color: #1e3a8a; font-size: 1.8rem; }
        header p { margin: 0; color: #64748b; }

        .layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }

        @media (min-width: 768px) {
            .layout { grid-template-columns: 540px 1fr; }
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            box-sizing: border-box;
        }

        .canvas-container {
            display: flex;
            justify-content: center;
            align-items: center;
            background: #ffffff;
            width: 500px;
            height: 490px;
        }

        canvas {
            width: 460px;
            height: 410px;
        }

        .section-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: #1e3a8a;
            margin: 0 0 12px 0;
            padding-bottom: 4px;
            border-bottom: 2px solid var(--border);
        }

        .control-group {
            background: #f8fafc;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 12px;
            border: 1px solid var(--border);
        }

        .control-label {
            display: flex;
            justify-content: space-between;
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 6px;
        }

        .control-label span.val {
            color: var(--primary);
            font-weight: 700;
        }

        input[type="range"] {
            width: 100%;
            margin: 0;
            cursor: pointer;
        }

        .assistant-box {
            background: #f0fdf4;
            border-left: 4px solid #16a34a;
            padding: 12px;
            border-radius: 0 8px 8px 0;
            margin-top: 12px;
            height: 95px;
            box-sizing: border-box;
            overflow: hidden;
        }

        .assistant-box h4 {
            margin: 0 0 4px 0;
            color: #14532d;
            font-size: 0.9rem;
        }

        .assistant-box p {
            margin: 0;
            font-size: 0.85rem;
            color: #166534;
        }

        .btn-reset {
            width: 100%;
            background: #64748b;
            color: white;
            border: none;
            padding: 10px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 12px;
            transition: background 0.2s;
        }
        .btn-reset:hover { background: #475569; }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Laboratorio de Microeconomía</h1>
        <p>Diferencia entre Cambios en la Cantidad Demandada y Cambios en la Demanda</p>
    </header>

    <div class="layout">
        <!-- COLUMNA IZQUIERDA: GRÁFICO CON CURVA AZUL -->
        <div class="card canvas-container">
            <canvas id="marketChart" width="460" height="410"></canvas>
        </div>

        <!-- COLUMNA DERECHA: CONTROLES Y ASISTENTE -->
        <div class="card">
            <div class="section-title">1. Modificar Precio (Factor Endógeno)</div>
            <div class="control-group" style="border-left: 4px solid var(--point-color);">
                <div class="control-label">
                    <label for="sliderPrecio">Precio del Bien ($ P):</label>
                    <span class="val" id="valPrecio">50</span>
                </div>
                <input type="range" id="sliderPrecio" min="10" max="90" value="50">
            </div>

            <div class="section-title">2. Modificar Determinantes (Factores Exógenos)</div>
            <div class="control-group" style="border-left: 4px solid var(--primary);">
                <div class="control-label">
                    <label for="sliderIngreso">Nivel de Ingreso de la Población:</label>
                    <span class="val" id="valIngreso">Normal</span>
                </div>
                <input type="range" id="sliderIngreso" min="-20" max="20" value="0" step="10">
            </div>

            <div class="control-group" style="border-left: 4px solid var(--primary);">
                <div class="control-label">
                    <label for="sliderPreferencias">Gustos y Preferencias por el Bien:</label>
                    <span class="val" id="valPreferencias">Neutrales</span>
                </div>
                <input type="range" id="sliderPreferencias" min="-20" max="20" value="0" step="10">
            </div>

            <div class="assistant-box">
                <h4>💡 Lección en tiempo real:</h4>
                <p id="textoAsistente">Mueve el Precio para ver un cambio en la cantidad demandada, o altera el Ingreso y los Gustos para ver un cambio en la demanda.</p>
            </div>

            <button class="btn-reset" id="btnReset">Restablecer Mercado Base</button>
        </div>
    </div>
</div>

<script>
    const canvas = document.getElementById('marketChart');
    const ctx = canvas.getContext('2d');

    const sliderPrecio = document.getElementById('sliderPrecio');
    const sliderIngreso = document.getElementById('sliderIngreso');
    const sliderPreferencias = document.getElementById('sliderPreferencias');
    const valPrecio = document.getElementById('valPrecio');
    const valIngreso = document.getElementById('valIngreso');
    const valPreferencias = document.getElementById('valPreferencias');
    const textoAsistente = document.getElementById('textoAsistente');
    const btnReset = document.getElementById('btnReset');

    let aBase = 100; 
    let b = 1;

    function obtenerTextoTextoExogeno(valor) {
        if (valor > 0) return "Incremento (+)";
        if (valor < 0) return "Reducción (-)";
        return "Estable / Normal";
    }

    function dibujarGrafico() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        let P_actual = parseFloat(sliderPrecio.value);
        let modIngreso = parseFloat(sliderIngreso.value);
        let modPreferencias = parseFloat(sliderPreferencias.value);

        let a_actual = aBase + modIngreso + modPreferencias;
        let Q_actual = a_actual - (b * P_actual);
        if(Q_actual < 0) Q_actual = 0;

        const margin = { top: 40, right: 30, bottom: 45, left: 65 };
        const graphWidth = canvas.width - margin.left - margin.right;
        const graphHeight = canvas.height - margin.top - margin.bottom;

        function getXPixel(qVal) { return margin.left + (qVal / 120) * graphWidth; }
        function getYPixel(pVal) { return margin.top + graphHeight - (pVal / 100) * graphHeight; }

        // Ejes
        ctx.strokeStyle = '#64748b';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(margin.left, margin.top);
        ctx.lineTo(margin.left, canvas.height - margin.bottom);
        ctx.lineTo(canvas.width - margin.right, canvas.height - margin.bottom);
        ctx.stroke();

        ctx.fillStyle = '#1e293b';
        ctx.font = 'bold 14px sans-serif';
        ctx.fillText('Precio (P)', margin.left - 25, margin.top - 15);
        ctx.fillText('Cantidad (Q)', canvas.width - margin.right - 45, canvas.height - margin.bottom + 35);

        // Curva D (Azulada)
        let pStart = 100;
        let qStart = a_actual - (b * pStart);
        if(qStart < 0) { qStart = 0; pStart = a_actual / b; }

        let pEnd = 0;
        let qEnd = a_actual;

        ctx.strokeStyle = 'var(--demand-color)';
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(getXPixel(qStart), getYPixel(pStart));
        ctx.lineTo(getXPixel(qEnd), getYPixel(pEnd));
        ctx.stroke();

        ctx.fillStyle = 'var(--demand-color)';
        ctx.font = 'italic bold 14px sans-serif';
        ctx.fillText('Demanda (D)', getXPixel(qEnd) - 80, getYPixel(pEnd) - 12);

        // Proyecciones
        let xPt = getXPixel(Q_actual);
        let yPt = getYPixel(P_actual);

        ctx.strokeStyle = '#94a3b8';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([4, 4]);
        
        ctx.beginPath();
        ctx.moveTo(xPt, yPt);
        ctx.lineTo(margin.left, yPt);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(xPt, yPt);
        ctx.lineTo(xPt, canvas.height - margin.bottom);
        ctx.stroke();
        ctx.setLineDash([]);

        // Punto de equilibrio
        ctx.fillStyle = 'var(--point-color)';
        ctx.beginPath();
        ctx.arc(xPt, yPt, 6, 0, 2 * Math.PI);
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.stroke();

        // Valores numéricos en los ejes
        ctx.fillStyle = '#1e293b';
        ctx.font = 'bold 15px sans-serif';
        ctx.textAlign = 'right';
        ctx.fillText('$' + P_actual, margin.left - 10, yPt + 5);
        
        ctx.textAlign = 'center';
        ctx.fillText(Math.round(Q_actual) + ' u', xPt, canvas.height - margin.bottom + 22);
    }

    function actualizarLaboratorio(origen) {
        let pVal = sliderPrecio.value;
        let ingVal = parseFloat(sliderIngreso.value);
        let prefVal = parseFloat(sliderPreferencias.value);

        valPrecio.innerText = pVal;
        valIngreso.innerText = obtenerTextoTextoExogeno(ingVal);
        valPreferencias.innerText = obtenerTextoTextoExogeno(prefVal);

        if (origen === 'precio') {
            textoAsistente.innerHTML = `<strong>Cambio en la Cantidad Demandada:</strong> Estás alterando el precio del propio bien. La estructura de la curva no cambia; el punto verde solo se mueve <strong>a lo largo de la misma recta</strong>.`;
        } else if (origen === 'exogeno') {
            if (ingVal === 0 && prefVal === 0) {
                textoAsistente.innerHTML = `El mercado regresó a su equilibrio base. Las condiciones externas son estables y la curva ha vuelto a su posición de referencia inicial.`;
            } else {
                let dir = (ingVal + prefVal > 0) ? "derecha (expansión)" : "izquierda (contracción)";
                textoAsistente.innerHTML = `<strong>Cambio en la Demanda:</strong> Modificaste un factor externo al precio. El precio se mantiene fijo, pero <strong>toda la curva de demanda se desplaza hacia la ${dir}</strong>.`;
            }
        }

        dibujarGrafico();
    }

    sliderPrecio.addEventListener('input', () => actualizarLaboratorio('precio'));
    sliderIngreso.addEventListener('input', () => actualizarLaboratorio('exogeno'));
    sliderPreferencias.addEventListener('input', () => actualizarLaboratorio('exogeno'));

    btnReset.addEventListener('click', () => {
        sliderPrecio.value = 50;
        sliderIngreso.value = 0;
        sliderPreferencias.value = 0;
        textoAsistente.innerHTML = `El mercado se ha restablecido. Pon a prueba a tus alumnos: pídeles que suban el precio y expliquen por qué la función de demanda se mantiene inmóvil.`;
        actualizarLaboratorio('base');
    });

    actualizarLaboratorio('base');
</script>

</body>
</html>
